  },
  "argument_chains": [
    {
      "title": "根据与存在：区分并不等于外在分离",
      "locator": "初版429–430；转录段24",
      "premise": "若绝对者之外没有别物，根据就不能简单放在外部。",
      "reasoning": "文本区分存在者和其存在的根据，以自然中的重力/光说明依存关系；继而明确，先行不是时间顺序，也不是本质优先，双方互相预设。",
      "limit": "这是形而上学解释和作者自己的自然哲学类比，不是现代物理；不得据此宣布实际物理先后。"
    },
    {
      "title": "生成中的分化：不是抽走差异得到统一",
      "locator": "段25–26",
      "premise": "原作要说明有区别的个体怎样生成，而非只被包含在一个静态概念里。",
      "reasoning": "从渴望、思想形成到植物展开，文本反复描述力量区分后显出其结合；再将这种叙述推进到人的两种原则。",
      "limit": "类比承担解释功能，未独立证明神学；植物、心理、宇宙论不是三个独立实证。"
    },
    {
      "title": "可能、实际与倒置",
      "locator": "段27与30",
      "premise": "两原则可分只说明恶的可能，实际恶须另外说明。",
      "reasoning": "文本将恶写成局部意志占据整体地位，借疾病说明部分独立化带来的失调；又排除把恶仅说成动物性、感性或理性缺席，因为被动受因支配不足说明可归责的恶。",
      "limit": "疾病不是患者道德过错的诊断；动物例子是边界，不能拿来证明动物有同一自由。"
    },
    {
      "title": "系词不消除关系差别",
      "locator": "完整段14",
      "premise": "说两个规定属于同一者，不必说它们在同一方面毫无分别。",
      "reasoning": "原文先以身体与蓝色分析同一主项下不同规定，再检查善/恶、自由/必然与身/心的误读，最后借隐含与展开说明主谓关系。",
      "limit": "这是原作局部程序；不能把任何相反断言都用层级不同消掉，须具体交代同一者、方面与依存关系。"
    }
  ],
